# ==============================================================================
# Receipt OCR Hub - Environment Configuration (.env)
# ==============================================================================

# Master key for /api/v1/admin/* endpoints (adding new users/bots)
ADMIN_API_KEY=change-me-admin-master-secret

# Default Cloud OCR Provider: "openai" (works with OpenAI, OpenRouter, etc.) or "gemini"
OCR_PROVIDER=openai
OCR_MODEL=gpt-4o-mini

# OpenAI / OpenAI-compatible settings (e.g. OpenAI, OpenRouter, Groq, LiteLLM)
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1

# Google Gemini API settings (used when OCR_PROVIDER=gemini)
GEMINI_API_KEY=your-gemini-api-key-here

# Optional bootstrap tenant (automatically creates/updates your primary bot on startup)
DEFAULT_TENANT_NAME=admin
DEFAULT_TELEGRAM_BOT_TOKEN=
DEFAULT_ALLOWED_CHAT_IDS=
DEFAULT_WEBHOOK_URL=http://host.docker.internal:8000/api/receipts/webhook
DEFAULT_WEBHOOK_SECRET=your-biometer-api-token

# OCR & Queue tuning
OCR_TIMEOUT_SECONDS=120
RECEIPT_OCR_CONFIDENCE_THRESHOLD=0.7
TELEGRAM_POLL_INTERVAL_SECONDS=5
TELEGRAM_BATCH_COOLDOWN_SECONDS=90
TELEGRAM_BATCH_DEBOUNCE_SECONDS=5

# FastAPI server binding
API_HOST=0.0.0.0
API_PORT=8080
